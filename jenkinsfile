pipeline {
    agent any

    stages {
        stage('Lint') {
            steps {
                echo 'Шаг 1: Проверка качества и синтаксиса кода (Linting)...'
            }
        }
        stage('Test') {
            steps {
                echo 'Шаг 2: Запуск автоматических юнит-тестов...'
            }
        }
        stage('Build') {
            steps {
                echo 'Шаг 3: Сборка артефактов приложения...'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Шаг 4: Развертывание (Deploy) приложения...'
            }
        }
    }
}